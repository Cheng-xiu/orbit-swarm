# Copy to .env only when you are ready to enable a live provider.
# Do not commit real credentials.
# Runtime mode: 0=single assistant, 1=mid (5 slots), 2=high (20 slots), 3=extreme (100 slots).
# ORBIT_MODE is the canonical name; ORBIT_SWARM_MODE, SWARM_MODE, and MODE are accepted aliases.
ORBIT_MODE=0

# Legacy/default OpenAI-compatible provider (kept for existing deployments).
A6_PROVIDER_NAME=a6api
A6_OPENAI_BASE_URL=https://your-a6api-host/v1
A6_OPENAI_API_KEY=
A6_MODEL_HIGH=gpt-5.6-sol
A6_MODEL_MEDIUM=gpt-5.6-terra
A6_MODEL_LOW=gpt-5.6-luna
A6_MODEL_ULTRA=gpt-5.6-sol
A6_REASONING_HIGH=high
A6_REASONING_MEDIUM=medium
A6_REASONING_LOW=low
A6_REASONING_ULTRA=xhigh

# Optional provider credentials. The runtime only uses these when simulation is
# disabled and never returns the key in /api/system or persisted state.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
CODEKEY_API_KEY=

# Optional JSON declarations. Values must be JSON objects/lists; malformed
# entries are ignored so one unavailable provider cannot stop the cluster.
# ORBIT_PROVIDERS_JSON={"providers":[{"id":"codekey","protocol":"openai_chat","base_url":"https://example.invalid/v1","api_key_env":"CODEKEY_API_KEY","models":["claude-opus-5"]}]}
# ORBIT_ROUTES_JSON={"routes":[{"scope":"role","key":"mode-2/architect","provider_id":"codekey","model_id":"claude-opus-5"}]}

# Force a model family or model id offline for deterministic quota/key-failure tests.
ORBIT_UNAVAILABLE_MODELS=

# Persistent state and context safeguards.
# ORBIT_SWARM_DATA_DIR=work/state
ORBIT_CONTEXT_LIMIT=128000
ORBIT_CONTEXT_THRESHOLD=0.85
ORBIT_CONTEXT_FALLBACK_MODEL=long-context-model
ORBIT_HR_ERROR_THRESHOLD=0.75
ORBIT_HR_MIN_TASKS=3

# Optional per-role caps. Omitted values use each role's catalog maximum.
# ORBIT_MAX_FRONTEND=3
# ORBIT_MAX_BACKEND=3
# ORBIT_MAX_ROLE_ARCHITECT=1

SWARM_WEIGHT_LOW=1
SWARM_WEIGHT_MEDIUM=2
SWARM_WEIGHT_HIGH=5
SWARM_WEIGHT_ULTRA=8
SWARM_MAX_WEIGHT=30
SWARM_CLUSTER_REASONING=high
SWARM_SIMULATION=true
